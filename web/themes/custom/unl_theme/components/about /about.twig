<section class="unl-about">
  <div class="unl-about__container">
    
    <div class="unl-about__content">
      
      {% if titulo or titulo_2 %}
        <h2 class="unl-about__title">
          {{ titulo }}
          {% if titulo_2 %}
            <span class="unl-about__highlight">{{ titulo_2 }}</span>
          {% endif %}
        </h2>
        
        {% set is_default = (not color or color == 'bg-gray-100') %}
        <div class="unl-about__divider {{ is_default ? 'unl-about__divider--multicolor' : color }}"></div>
        
      {% endif %}
      
      {% if descripcion %}
        <div class="unl-about__description">
          {{ descripcion }}
        </div>
      {% endif %}
      
      {% if enlace %}
        <div class="unl-about__action">
          {{ enlace }}
        </div>
      {% endif %}
    </div>

    {% if media %}
      <div class="unl-about__media">
        {{ media }}
      </div>
    {% endif %}

  </div>
</section>