{% set modificador_variante = variante == 'fade' ? 'unl-about--fade' : '' %}

<section class="unl-about {{ modificador_variante }}">
  {% set has_media = media|render|trim is not empty %}
  <div class="unl-about__container {{ not has_media ? 'unl-about__container--no-media' : '' }}">
    
    <div class="unl-about__content">
      
      {% if titulo or titulo_2 %}
        <h2 class="unl-about__title">
          {% if titulo %}
            <span class="unl-about__highlight">{{ titulo }}</span>
          {% endif %}

          {{ titulo_2 }}
          
        </h2>
        
        {% set is_default = (not color or color == 'bg-gray-100') %}
        <div class="unl-about__divider {{ is_default ? 'unl-about__divider--multicolor' : color }}"></div>
      {% endif %}
      
      {% if descripcion %}
        <div class="unl-about__description">
          {{ descripcion }}
        </div>
      {% endif %}
      
      {% if enlace %}
        <div class="unl-about__action">
          {{ enlace }}
        </div>
      {% endif %}
    </div>

    {% if has_media %}
      <div class="unl-about__media">
        {{ media }}
      </div>
    {% endif %}

  </div>
</section>