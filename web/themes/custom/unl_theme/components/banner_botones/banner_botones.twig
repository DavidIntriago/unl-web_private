{{ attach_library('unl_theme/banner_botones') }}

{% set clase_variante = variante == 'informativa' ? 'banner--minimal' : 'banner--default' %}

<section class="banner {{ clase_variante }} {{ color_tema }} animar-scroll">
  
  {% if fondo_url %}
    <div class="banner__fondo" style="background-image: url('{{ fondo_url }}');" aria-hidden="true"></div>
  {% endif %}
  
  <div class="banner__overlay" aria-hidden="true"></div>

  <div class="banner__contenedor">
    <div class="banner__texto">
      
      {% if variante == 'informativa' %}
        <div class="banner__divider"></div>
      {% endif %}
      
      {% if titulo %}
        <h2 class="banner__titulo">{{ titulo }}</h2>
      {% endif %}
      
      {% if descripcion %}
        <p class="banner__descripcion">{{ descripcion }}</p>
      {% endif %}
    </div>

    {% if enlaces|render|trim %}
      <div class="banner__acciones">
        {{ enlaces }}
      </div>
    {% endif %}
  </div>
</section>