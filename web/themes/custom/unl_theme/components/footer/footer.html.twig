<footer class="site-footer">

{% if page.fondo_footer %}
  <div class="site-footer__bg-video-wrapper" aria-hidden="true">
    <div class="site-footer__bg-video-source">
      {{ page.fondo_footer }}
    </div>
  </div>
  <div class="site-footer__bg-overlay" aria-hidden="true"></div>
{% endif %}

  <div class="site-footer__container">

    <div class="site-footer__branding">
      {{ page.branding }}
    </div>

    <div class="site-footer__contact">
      <h2>Contacto</h2>
      {{ page.footer_contact }}
    </div>

    <div class="site-footer__map">
      <h2>Ubicación</h2>
      <div class="site-footer__map-block">
        {{ page.footer_map }}
      </div>
    </div>

  </div>

  <div class="site-footer__bottom">
    © {{ "now"|date("Y") }} Universidad Nacional de Loja
  </div>

</footer>