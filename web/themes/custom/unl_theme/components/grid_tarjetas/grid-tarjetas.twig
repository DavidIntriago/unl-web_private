<div class="grid-tarjetas-wrapper">
  
  {% if titulo %}
    <div class="grid-tarjetas__header">
      <h2 class="grid-tarjetas__titulo">
        {{ titulo }}
      </h2>
      <div class="grid-tarjetas__divider"></div>
    </div>
  {% endif %}

  {% set modificador_grid = (variante == 'facultad') ? 'grid-tarjetas-container--facultad' : 'grid-tarjetas-container--default' %}

  <section class="grid-tarjetas-container {{ modificador_grid }}">
    {% block items %}
    {% endblock %}
  </section>
  
</div>