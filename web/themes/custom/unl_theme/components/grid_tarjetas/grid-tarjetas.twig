{% set modificador_wrapper = variante ? 'grid-tarjetas-wrapper--' ~ variante : '' %}

<div class="grid-tarjetas-wrapper {{ modificador_wrapper }}">

  {% if titulo %}
    <div class="grid-tarjetas__header">
      <h2 class="grid-tarjetas__titulo">
        {{ titulo }}
      </h2>
      <div class="grid-tarjetas__divider"></div>
    </div>
  {% endif %}

  {% if variante == 'imagenes' %}
    <div class="grid-tarjetas__acciones-top">
      <div class="grid-tarjetas__btn-ver-mas">
        <a href="{{ enlace }}" class="grid-tarjetas__btn-ver-mas" aria-label="Ver más">Ver más</a>
      </div>
    </div>
  {% endif %}
    
  {% set modificador_grid = variante == 'sustantiva'
    ? 'grid-tarjetas-container--sustantiva'
    : (variante == 'facultad'
      ? 'grid-tarjetas-container--facultad'
      : (variante == 'contador'
        ? 'grid-tarjetas-container--contador'
        : (variante == 'sitios_interes'
          ? 'grid-tarjetas-container--sitios_interes'
          : (variante == 'imagenes'
            ? 'grid-tarjetas-container--imagenes'
            : (variante == 'autoridades'
              ? 'grid-tarjetas-container--autoridades'
              : (variante == 'marca'
                ? 'grid-tarjetas-container--marcas'
                  : (variante == 'default'
                    ? 'grid-tarjetas-container--default'
                    : ''))))))) %}

  <section class="grid-tarjetas-container {{ modificador_grid }}">
    {% if variante == 'sitios_interes' or variante == 'marcas' or variante == 'marca' %}
      <button class="carrusel-sitios-flecha prev" aria-label="Anterior">&#10094;</button>
      <div class="carrusel-sitios-viewport">
        <div class="carrusel-sitios-track">
    {% endif %}

    {% block items %}
    {% endblock %}
    {% if variante == 'sitios_interes' or variante == 'marcas' or variante == 'marca' %}        </div>
      </div>
      <button class="carrusel-sitios-flecha next" aria-label="Siguiente">&#10095;</button>
    {% endif %}
  </section>
    {# Horario de atención: solo en autoridades y solo si el editor lo llenó #}
  {% if variante == 'autoridades' and (atencion or horarios) %}
    <div class="grid-tarjetas__horario">
      {% if atencion %}
        <p class="grid-tarjetas__horario-item grid-tarjetas__horario-item--atencion">
          <strong>Atención:</strong> {{ atencion }}
        </p>
      {% endif %}
      {% if horarios %}
        <p class="grid-tarjetas__horario-item grid-tarjetas__horario-item--horarios">
          <strong>Horarios:</strong> {{ horarios }}
        </p>
      {% endif %}
    </div>
  {% endif %}

</div>