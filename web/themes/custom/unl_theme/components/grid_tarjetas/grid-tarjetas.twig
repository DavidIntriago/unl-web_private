{% set modificador_wrapper = variante ? 'grid-tarjetas-wrapper--' ~ variante : '' %}

<div class="grid-tarjetas-wrapper {{ modificador_wrapper }}">

  {% if titulo %}
    <div class="grid-tarjetas__header">
      <h2 class="grid-tarjetas__titulo">
        {{ titulo }}
      </h2>
      <div class="grid-tarjetas__divider"></div>
    </div>
  {% endif %}

  {% if variante == 'imagenes' %}
    <div class="grid-tarjetas__acciones-top">
      <div class="grid-tarjetas__btn-ver-mas">
        <a href="{{ enlace }}" class="grid-tarjetas__btn-ver-mas" aria-label="Ver más">Ver más</a>
      </div>
    </div>
  {% endif %}

  {# Clase del contenedor: grid-tarjetas-container--<variante>.
     La única excepción es "marca", cuya clase es "marcas". #}
  {% set modificador_grid = variante
    ? 'grid-tarjetas-container--' ~ (variante == 'marca' ? 'marcas' : variante)
    : '' %}

  <section class="grid-tarjetas-container {{ modificador_grid }}">
    {% if variante == 'sitios_interes' or variante == 'marcas' or variante == 'marca' %}
      <button class="carrusel-sitios-flecha prev" aria-label="Anterior">&#10094;</button>
      <div class="carrusel-sitios-viewport">
        <div class="carrusel-sitios-track">
    {% endif %}

    {% block items %}
    {% endblock %}

    {% if variante == 'sitios_interes' or variante == 'marcas' or variante == 'marca' %}
        </div>
      </div>
      <button class="carrusel-sitios-flecha next" aria-label="Siguiente">&#10095;</button>
    {% endif %}
  </section>

</div>