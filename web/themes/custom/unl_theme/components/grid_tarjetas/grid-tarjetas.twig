<div class="grid-tarjetas-wrapper" style="margin-top: 5rem; margin-bottom: 3rem;">
  
  {% if titulo %}
    <div class="tarjetas-header" style="text-align: center; margin-bottom: 2rem;">
      <h2 style="font-size: 2rem; font-weight: bold; color: #333;">
        {{ titulo }}
      </h2>
    </div>
  {% endif %}

  <section class="grid-tarjetas-container">
    {% block items %}
    {% endblock %}
  </section>
  
</div>