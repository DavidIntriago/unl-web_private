<div class="hero-carrusel-contenedor">
  <div class="carrusel-slides">
    {% for slide in diapositivas %}
      <div class="slide-item">

        {% if slide.media_url %}

          {# IMAGEN #}
          {% if slide.media_tipo == 'horizontal_pantalla_completa' %}
            <img src="{{ slide.media_url }}" class="slide-bg" alt="{{ slide.titulo }}">

          {# VIDEO LOCAL #}
          {% elseif slide.media_tipo == 'video' %}
            <video src="{{ slide.media_url }}" class="slide-bg" autoplay loop muted playsinline></video>

          {# VIDEO REMOTO #}
          {% elseif slide.media_tipo == 'remote_video' %}

            {# Extraemos el ID de la URL de YouTube (soporta formato normal y formato corto youtu.be) #}
            {% set video_id = '' %}
            {% if 'youtube.com/watch' in slide.media_url %}
              {% set video_id = slide.media_url|split('v=')|last|split('&')|first %}
            {% elseif 'youtu.be/' in slide.media_url %}
              {% set video_id = slide.media_url|split('/')|last|split('?')|first %}
            {% endif %}

            {% if video_id %}
              {# Iframe silencioso, automático y en bucle #}
              <iframe class="slide-bg slide-bg--iframe"
                      src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&loop=1&playlist={{ video_id }}&modestbranding=1&playsinline=1"
                      frameborder="0"
                      allow="autoplay; fullscreen"
                      allowfullscreen>
              </iframe>
            {% endif %}

          {% endif %}
        {% endif %}

        <div class="slide-overlay"></div>
        <div class="slide-texto">
          <h2>{{ slide.titulo }}</h2>
          {# Envoltorio para animar descripción + botón hasta su altura real #}
          <div class="slide-extra">
            <div>
              <p>{{ slide.descripcion }}</p>
              {% if slide.enlace_url %}
                <a href="{{ slide.enlace_url }}" class="btn-universidad">{{ slide.enlace_texto|default('Descubrir más') }}</a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if notificaciones|length > 0 %}
    <div class="hero-notificaciones-flotantes">
      {% for notificacion in notificaciones %}
        {{ notificacion }}
      {% endfor %}
    </div>
  {% endif %}

  <div class="carrusel-controles" role="tablist" aria-label="Diapositivas del carrusel"></div>
</div>