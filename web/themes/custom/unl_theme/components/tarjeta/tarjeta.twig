{% if variante == 'sustantiva' %}
  {# ------sustantiva: foto de fondo + etiqueta de color que crece a
     medida que la tarjeta se achica (fila flex tipo institucional) #}

  <article class="tarjeta-sustantiva">

    {% if imagen %}
      <div class="tarjeta-sustantiva__img">
        {{ imagen }}
      </div>
    {% endif %}

    <div class="tarjeta-sustantiva__etiqueta {{ color }}">
      {% if titulo %}
        <h3 class="tarjeta-sustantiva__titulo">{{ titulo|nl2br }}</h3>
      {% endif %}
      <span class="tarjeta-sustantiva__mas" aria-hidden="true">+</span>
    </div>

    {% if enlace %}
      <div class="tarjeta-sustantiva__enlace">
        {{ enlace }}
      </div>
    {% endif %}

  </article>
{% elseif variante == 'facultad' %}
  {# -------Facultadesssssssssss#}
  {% set classes = [
  'tarjeta-institucional',
  color
] %}

<article class="{{ classes|join(' ') }}">
  
  {% if imagen %}
    <div class="tarjeta-bg-img">
      {{ imagen }}
    </div>
  {% endif %}

  <div class="tarjeta-contenido">
    <h3 class="tarjeta-titulo">
      {{ titulo|nl2br }} 
    </h3>
  </div>

  {% if enlace %}
    <div class="tarjeta-institucional__enlace">
      {{ enlace }}
    </div>
  {% endif %}
  
</article>
{% elseif variante == 'contador' %}

  {# ------contador: ícono + número grande + etiqueta #}

  <article class="tarjeta-contador">

    {% if imagen %}
      <div class="tarjeta-contador__icono">
        {{ imagen }}
      </div>
    {% endif %}

    {% if titulo %}
      <div class="tarjeta-contador__numero">{{ titulo }}</div>
    {% endif %}

    {% if descripcion %}
      <div class="tarjeta-contador__etiqueta">{{ descripcion }}</div>
    {% endif %}

  </article>
{% elseif variante == 'sitios_interes' %}

  {# ------sitios de interés: ícono + nombre, tarjeta completa clickeable #}

  <article class="tarjeta-sitio-interes">

    {% if imagen %}
      <div class="tarjeta-sitio-interes__icono">
        {{ imagen }}
      </div>
    {% endif %}

    {% if titulo %}
      <h3 class="tarjeta-sitio-interes__titulo">{{ titulo }}</h3>
    {% endif %}

    {% if enlace %}
      <div class="tarjeta-sitio-interes__enlace">
        {{ enlace }}
      </div>
    {% endif %}

  </article>
{% elseif variante == 'autoridades' %}

  {# ------autoridades: foto + overlay con nombre, cargo y botón
     "Ver perfil completo" (abre modal con información adicional) #}

  <article class="tarjeta-autoridad">

    {% if imagen %}
      <div class="tarjeta-autoridad__imagen">
        {{ imagen }}
      </div>
    {% endif %}

    <div class="tarjeta-autoridad__overlay">
      <div class="tarjeta-autoridad__marco">
        {% if titulo %}
          <h3 class="tarjeta-autoridad__nombre">{{ titulo }}</h3>
        {% endif %}

        {% if descripcion %}
          <div class="tarjeta-autoridad__cargo">{{ descripcion }}</div>
        {% endif %}

        {% if informacion_adicional %}
          <div class="tarjeta-autoridad__info" data-info-contenido hidden>
            {{ informacion_adicional|raw }}
          </div>
          <button type="button" class="tarjeta-autoridad__ver-mas" data-info-toggle>
            Ver perfil completo
          </button>
        {% endif %}
      </div>
    </div>

    {% if enlace %}
      <div class="tarjeta-autoridad__enlace">
        {{ enlace }}
      </div>
    {% endif %}

  </article>
{% elseif variante == 'imagenes' %}

  {# ------imagenes: solo la imagen, sin título ni descripción #}

  <article class="tarjeta-imagen">

    {% if imagen %}
      {{ imagen }}
    {% endif %}

    {% if enlace %}
      <div class="tarjeta-imagen__enlace">
        {{ enlace }}
      </div>
    {% endif %}

  </article>
  {% elseif variante == 'marcas' %}

  {# ------marcas: logo pequeño, gris por defecto, color al hover #}

  <article class="tarjeta-marca">

    {% if imagen %}
      <div class="tarjeta-marca__img">
        {{ imagen }}
      </div>
    {% endif %}

    {% if enlace %}
      <div class="tarjeta-marca__enlace">
        {{ enlace }}
      </div>
    {% endif %}

  </article>
{% else %}
  
  {# ------defaultttttttttttt #}
  
  {% set classes = [
    'tarjeta-default',
    color
  ] %}

  <article class="{{ classes|join(' ') }}">
    
    {% if imagen %}
      <div class="tarjeta-default__imagen">
        {{ imagen }}
      </div>
    {% endif %}

    <div class="tarjeta-default__contenido">
      
      {% if titulo %}
        <h3 class="tarjeta-default__titulo">{{ titulo }}</h3>
      {% endif %}

      {% if descripcion %}
        <div class="tarjeta-default__descripcion">
          {{ descripcion }}
        </div>
      {% endif %}

      {% if enlace %}
        <div class="tarjeta-default__enlace">
          {{ enlace }}
        </div>
      {% endif %}

    </div>
  </article>
{% endif %}