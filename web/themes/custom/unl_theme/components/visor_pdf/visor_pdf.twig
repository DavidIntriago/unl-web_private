{{ attach_library('unl_theme/visor_pdf') }}

<div class="unl-visor-pdf">
  <div class="unl-visor-pdf__iframe-wrapper">
    <iframe 
      src="{{ url }}" 
      type="application/pdf" 
      width="100%" 
      height="700px" 
      frameborder="0" 
      title="Visor de documento institucional">
        {# Mensaje de respaldo si el navegador no soporta PDFs incrustados (ej. móviles antiguos) #}
        <p>Tu navegador no soporta la previsualización de PDFs. <a href="{{ url }}">Haz clic aquí para descargar el documento</a>.</p>
    </iframe>
  </div>

  <div class="unl-visor-pdf__acciones">
    <a href="{{ url }}" class="unl-boton-descargar" download target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      Descargar Documento PDF
    </a>
  </div>
</div>