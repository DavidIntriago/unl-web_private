<article class="nodo-carrera">
  <div class="nodo-carrera__contenido">

    {#
      Se excluyen los campos que se pintan en otro lugar o que son solo datos:
      - Hero: field_imagen_hero (page.html.twig)
      - Tarjeta y vistas: field_codigo, field_foto_carrera, field_tipo_carrera,
        field_modalidad, field_jornada, field_semestres, field_puntaje_minimo, field_cupos
      Aquí quedan la descripción, el video y las secciones.
    #}
    {{ content|without(
      'field_imagen_hero',
      'field_codigo',
      'field_foto_carrera',
      'field_tipo_carrera',
      'field_modalidad',
      'field_jornada',
      'field_semestres',
      'field_puntaje_minimo',
      'field_cupos'
    ) }}

  </div>
</article>