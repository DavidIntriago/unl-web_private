      'field_descripcion_corta',
      'field_enlace_admisiones',
      'field_brochure',
      'field_titulo_obtener',
      'field_perfil_profesional',
      'field_semestres',
      'field_modalidad',
      'field_opciones_titulacion',
      'field_foto_carrera',
      'field_cupos',
      'field_puntaje_minimo',
      'field_jornada',
      'field_tipo_carrera'
    ) }}

  </div>
</article>