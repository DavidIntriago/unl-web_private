{{ attach_library('unl_theme/global') }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fustat:wght@200..800&display=swap" rel="stylesheet">



<div class="fondo-decorativo" aria-hidden="true">
  <span class="fondo-decorativo__particula fondo-decorativo__particula--1 forma--circulo  color--rojo"></span>
  <span class="fondo-decorativo__particula fondo-decorativo__particula--2 forma--circulo color--azul"></span>
  <span class="fondo-decorativo__particula fondo-decorativo__particula--3 forma--circulo  color--verde"></span>
  <span class="fondo-decorativo__particula fondo-decorativo__particula--4 forma--circulo  color--naranja"></span>
  <span class="fondo-decorativo__particula fondo-decorativo__particula--5 forma--circulo  color--amarillo"></span>
  <span class="fondo-decorativo__particula fondo-decorativo__particula--6 forma--circulo  color--morado"></span>
</div>



<div id="page-wrapper">

    {% if page.top_bar %}
    <div class="top-bar">
        {{ page.top_bar }}
    </div>
    {% endif %}


    {% include '@unl_theme/components/header/header.html.twig' %}


    {% if page.highlighted %}
    <section class="hero">
        {{ page.highlighted }}
    </section>
    {% endif %}


    <main class="site-content">
        {{ page.content }}
    </main>


    {% include '@unl_theme/components/footer/footer.html.twig' %}


</div>