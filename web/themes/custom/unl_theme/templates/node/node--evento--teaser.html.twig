<article class="evento-teaser">

  <div class="evento-teaser__imagen">

    {% if content.field_imagen|render|trim %}
      {{ content.field_imagen }}
    {% endif %}

    {% if content.field_fecha|render|trim %}
      <div class="evento-teaser__fecha">
        <span class="evento-teaser__dia">
            {{ node.field_fecha.value|date('d') }}
        </span>
        <span class="evento-teaser__mes">
            {{ node.field_fecha.value|date('M') }}
        </span>
      </div>
    {% endif %}

  </div>

  <div class="evento-teaser__contenido">

    <h3 class="evento-teaser__titulo">
      {{ label }}
    </h3>

    <div class="evento-teaser__divider"></div>

    <div class="evento-teaser__meta">

      {% if content.field_ubicacion|render|trim %}
        <div class="evento-teaser__meta-item evento-teaser__meta-item--ubicacion">
          {{ content.field_ubicacion }}
        </div>
      {% endif %}

      {% if content.field_area|render|trim %}
        <div class="evento-teaser__meta-item evento-teaser__meta-item--area">
          {{ content.field_area }}
        </div>
      {% endif %}

      {% if content.field_fecha|render|trim %}
        <div class="evento-teaser__meta-item evento-teaser__meta-item--hora">
          {{ content.field_fecha.value|date('H:i')}}
        </div>
      {% endif %}

    </div>

    {% if content.body|render|trim %}
      <div class="evento-teaser__cuerpo">
        {{ content.body }}
      </div>
    {% endif %}

  </div>

</article>