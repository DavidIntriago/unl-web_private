{{ attach_library('unl_theme/wavesurfer') }}

<article class="noticia-full">
  
  {% if content.field_imagen|render|trim is not empty %}
    <div class="noticia-full__portada">
      {{ content.field_imagen }}
    </div>
  {% endif %}

  <div class="noticia-full__contenedor">
    
    <header class="noticia-full__cabecera">
      <div class="noticia-full__meta">
        <span class="noticia-full__fecha">{{ node.createdtime|format_date('custom', 'd \\d\\e F \\d\\e Y') }}</span>
        
        {% if content.field_area|render|trim is not empty %}
          <span class="noticia-full__area">| {{ content.field_area }}</span>
        {% endif %}
      </div>
      
      <h1 class="noticia-full__titulo">{{ label }}</h1>
      <div class="noticia-full__separador"></div>
    </header>


    {% set url_compartir = url('<current>')|render|url_encode %}
    {% set titulo_compartir = label|url_encode %}

    <div class="noticia-compartir">
      <span class="noticia-compartir__texto">Compartir:</span>
      
      <div class="noticia-compartir__redes">
        
        {# Facebook #}
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ url_compartir }}" 
           target="_blank" rel="noopener noreferrer" 
           class="btn-compartir btn-compartir--facebook" 
           title="Compartir en Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path></svg>
        </a>

        {# Twitter #}
        <a href="https://twitter.com/intent/tweet?url={{ url_compartir }}&text={{ titulo_compartir }}" 
           target="_blank" rel="noopener noreferrer" 
           class="btn-compartir btn-compartir--x" 
           title="Compartir en X">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
        </a>

        {# Whatsapp #}
        <a href="https://api.whatsapp.com/send?text={{ titulo_compartir }}%20{{ url_compartir }}" 
           target="_blank" rel="noopener noreferrer" 
           class="btn-compartir btn-compartir--whatsapp" 
           title="Compartir por WhatsApp">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
        </a>
        
        {# LinkedIn #}
        <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ url_compartir }}&title={{ titulo_compartir }}" 
           target="_blank" rel="noopener noreferrer" 
           class="btn-compartir btn-compartir--linkedin" 
           title="Compartir en LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>

        {# Telegram #}
        <a href="https://t.me/share/url?url={{ url_compartir }}&text={{ titulo_compartir }}" 
           target="_blank" rel="noopener noreferrer" 
           class="btn-compartir btn-compartir--telegram" 
           title="Compartir en Telegram">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.888-.662 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </a>

      </div>
    </div>

    {% if node.field_audio.entity %}
      {% set audio_url = file_url(node.field_audio.entity.field_media_audio_file.entity.uri.value) %}
      
      <div class="audio-ondas-wrapper">
        
        <div class="audio-ondas-contenedor" data-audio-src="{{ audio_url }}">
          <button class="audio-ondas-btn" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor" class="icono-play"><path d="M8 5v14l11-7z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" class="icono-pausa" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </button>
          <div class="audio-ondas-lienzo"></div>
          <div class="audio-ondas-tiempo">0:00 / 0:00</div>
        </div>

        {% if node.field_audio.entity.field_descipcion_audio.value %}
          <div class="audio-ondas-descripcion">
            {{ node.field_audio.entity.field_descipcion_audio.value }}
          </div>
        {% endif %}
    {% endif %}

    <div class="noticia-full__cuerpo">
      {{ content.field_body }}
    </div>
  </div>
</article>