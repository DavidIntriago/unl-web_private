<article class="noticia-teaser">
  
  <a href="{{ url }}" class="noticia-teaser__enlace-global">
    
    <div class="noticia-teaser__imagen">
      {% if content.field_imagen|render|trim is not empty %}
        {{ content.field_imagen }}
      {% endif %}
    </div>

    <div class="noticia-teaser__etiquetas">
      
      <div class="noticia-teaser__fecha-caja">
        <span class="fecha-dia">{{ node.createdtime|date('d') }}</span>
        <span class="fecha-mes">{{ node.createdtime|format_date('custom', 'F')|slice(0, 3)|upper }}</span>
      </div>

{#
      {% if content.field_area|render|trim is not empty %}
        <div class="noticia-teaser__area-caja">
          {{ content.field_area }}
        </div>
      {% endif %}
#}
    </div>

    <div class="noticia-teaser__contenido">
      <h3 class="noticia-teaser__titulo">
        {{ label }}
      </h3>
    </div>

  </a>

</article>