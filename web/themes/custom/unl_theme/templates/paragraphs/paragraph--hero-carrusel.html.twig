{% block paragraph %}
  {% set slides_data = [] %}

  {% for key, child in content.field_diapositivas %}
    {% if key|first != '#' %}
      
      {% set url_imagen = '' %}
      {% if child['#paragraph'].field_imagen.entity %}
        {% set url_imagen = file_url(child['#paragraph'].field_imagen.entity.field_media_image.entity.uri.value) %}
      {% endif %}

      {% set slides_data = slides_data|merge([{
        titulo: child['#paragraph'].field_titulo.value,
        descripcion: child['#paragraph'].field_descripcion.value,
        imagen_url: url_imagen,
        enlace_url: child['#paragraph'].field_enlace.uri,
        enlace_texto: child['#paragraph'].field_enlace.title
      }]) %}

    {% endif %}
  {% endfor %}

  {% include 'unl_theme:hero_carrusel' with {
    diapositivas: slides_data
  } %}
{% endblock %}