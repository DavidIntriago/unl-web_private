{% block paragraph %}
  {% set slides_data = [] %}

  {# 1. PROCESAMOS LAS DIAPOSITIVAS #}
  {% for key, child in content.field_diapositivas %}
    {% if key|first != '#' %}
      
      {% set media_entity = child['#paragraph'].field_imagen.entity %}
      {% set url_media = '' %}
      {% set tipo_media = '' %}

      {% if media_entity %}
        {% set tipo_media = media_entity.bundle() %}

        {% if tipo_media == 'horizontal_pantalla_completa' %}
          {% set url_media = file_url(media_entity.field_media_image_5.entity.uri.value) %}
        {% elseif tipo_media == 'video' %}
          {% set url_media = file_url(media_entity.field_media_video_file.entity.uri.value) %}
        {% elseif tipo_media == 'remote_video' %}
          {% set url_media = media_entity.field_media_oembed_video.value %}
        {% endif %}
      {% endif %}

      {% set slides_data = slides_data|merge([{
        titulo: child['#paragraph'].field_titulo.value,
        descripcion: child['#paragraph'].field_descripcion.value,
        media_url: url_media,
        media_tipo: tipo_media, 
        enlace_url: child['#paragraph'].field_enlace.uri,
        enlace_texto: child['#paragraph'].field_enlace.title
      }]) %}

    {% endif %}
  {% endfor %}

  {# 2. PROCESAMOS Y LIMPIAMOS LAS NOTIFICACIONES #}
  {% set notificaciones_limpias = [] %}
  {% for key, child in content.field_notificacion_flotante %}
    {% if key|first != '#' %}
      {% set notificaciones_limpias = notificaciones_limpias|merge([child]) %}
    {% endif %}
  {% endfor %}

  {# 3. ENVIAMOS TODO AL COMPONENTE SDC #}
  {% include 'unl_theme:hero_carrusel' with {
    diapositivas: slides_data,
    notificaciones: notificaciones_limpias
  } %}
  
{% endblock paragraph %}