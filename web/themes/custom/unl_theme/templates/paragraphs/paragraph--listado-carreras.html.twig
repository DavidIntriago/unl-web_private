{{ attach_library('unl_theme/listado_carreras') }}
{# Sin título visible: el aria-label le da nombre a la sección para lectores de pantalla #}
<section class="listado-carreras" data-carreras-visibles="5" aria-label="Carreras">

  <div class="listado-carreras__encabezado">
    <button type="button" class="listado-carreras__ver-todas" aria-expanded="false">
      Ver toda la oferta
    </button>
  </div>

  <div class="listado-carreras__franja">
    {{ carreras }}
  </div>

</section>