{#
  Párrafo "Perfil".
  Los datos vienen de unl_theme_preprocess_paragraph__perfil():
  del Contacto si se eligió uno, o del propio párrafo si se llenó a mano.
  El estilo se lee del Grid perfiles que lo contiene.
#}
{% if not ocultar_perfil %}
  {% set padre = paragraph.getParentEntity() %}
  {% set estilo = padre and padre.hasField('field_estilo') and padre.field_estilo.value
    ? padre.field_estilo.value
    : 'perfil_extendido' %}

  {% include 'unl_theme:perfil' with perfil|merge({ estilo: estilo }) only %}
{% endif %}