<?php

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Render\Element;

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function unl_theme_form_user_login_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Envuelve usuario, contraseña y botón "Iniciar sesión" en un contenedor oculto.
  $form['name']['#prefix'] = '<div id="admin-login-fields">';
  $form['actions']['#suffix'] = '</div>';

  $form['admin_login_toggle'] = [
    '#type' => 'html_tag',
    '#tag' => 'button',
    '#value' => t('Inicio de sesión administradores'),
    '#attributes' => [
      'type' => 'button',
      'id' => 'admin-login-toggle',
      'class' => ['admin-login-toggle'],
    ],
    '#weight' => 100,
  ];

  $form['#attached']['library'][] = 'unl_theme/admin-login-toggle';
}

/**
 * Devuelve la etiqueta de un campo de lista ("Presencial"), no la clave ("presencial").
 * Si el campo es de texto normal, devuelve el texto tal cual.
 */
function _unl_theme_valor_legible($node, $campo) {
  if (!$node->hasField($campo) || $node->get($campo)->isEmpty()) {
    return '';
  }
  $valor = $node->get($campo)->value;
  $definicion = $node->get($campo)->getFieldDefinition()->getFieldStorageDefinition();
  if (str_starts_with($definicion->getType(), 'list_')) {
    $valores = options_allowed_values($definicion, $node);
    return $valores[$valor] ?? $valor;
  }
  return $valor;
}

/**
 * Variables generales para la página (Layout, Menús, Cabeceras, HERO, Footer).
 */
function unl_theme_preprocess_page(&$variables) {
  if (isset($variables['node']) && $variables['node'] instanceof \Drupal\node\NodeInterface) {
    $node = $variables['node'];
    
    // =========================================================
    // 1. CONFIGURACIÓN DE FACULTAD (Header, Footer Dinámico y Loader)
    // =========================================================
    $alias = \Drupal::service('path_alias.manager')
      ->getAliasByPath(\Drupal::service('path.current')->getPath());
    $codigo = explode('/', trim($alias, '/'))[0];
        // Si el nodo tiene su propio Código de Facultad (carrera, facultad),
    // ese manda sobre la URL: así toda la página (hero, malla, footer)
    // toma el mismo color y se actualiza al cambiar el campo.
    if ($node->hasField('field_codigo') && !$node->get('field_codigo')->isEmpty()) {
      $codigo = $node->get('field_codigo')->value;
    }
    
    $almacen = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_codigo');
    $facultades = $almacen ? options_allowed_values($almacen) : [];

    if (isset($facultades[$codigo])) {
      $variables['facultad_codigo'] = $codigo;
      $variables['facultad_nombre'] = $facultades[$codigo];
      $variables['logo_url'] = theme_get_setting('logo.url');

      // Consultar el nodo de la facultad para extraer los datos del Footer
      $ids = \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'facultades')
        ->condition('field_codigo', $codigo)
        ->condition('status', 1)
        ->range(0, 1)
        ->execute();
        
      if ($ids) {
        $facultad = \Drupal\node\Entity\Node::load(reset($ids));
        
        $variables['footer_facultad'] = [
          'direccion' => $facultad->hasField('field_direccion') ? $facultad->get('field_direccion')->value : '',
          'telefono' => $facultad->hasField('field_telefono') ? $facultad->get('field_telefono')->value : '',
          'correo' => $facultad->hasField('field_correo') ? $facultad->get('field_correo')->value : '',
          'columnas' => [],
        ];

        // Columnas personalizadas de enlaces por cada facultad
        $columnas = $facultad->hasField('field_columnas_footer') ? $facultad->get('field_columnas_footer') : [];
        foreach ($columnas as $item) {
          $columna = $item->entity;
          if (!$columna) continue;
          
          $enlaces = [];
          if ($columna->hasField('field_enlaces')) {
            foreach ($columna->get('field_enlaces') as $enlace) {
              $enlaces[] = [
                'titulo' => $enlace->title,
                'url' => $enlace->getUrl()->toString(),
              ];
            }
          }
          
          $variables['footer_facultad']['columnas'][] = [
            'titulo' => $columna->hasField('field_titulo_columna') ? $columna->get('field_titulo_columna')->value : '',
            'enlaces' => $enlaces,
          ];
        }
        // Caché atada al nodo de la facultad
        $variables['#cache']['tags'][] = 'node:' . $facultad->id();
      }

      // Columna fija "UNL": Enlaces del menú Footer UNL
      $arbol = \Drupal::menuTree();
      $parametros = (new \Drupal\Core\Menu\MenuTreeParameters())
        ->setMaxDepth(1)
        ->onlyEnabledLinks();
      $elementos = $arbol->transform($arbol->load('footer-unl', $parametros), [
        ['callable' => 'menu.default_tree_manipulators:checkAccess'],
        ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
      ]);
      
      $variables['footer_unl'] = [];
      foreach ($elementos as $elemento) {
        if ($elemento->access && !$elemento->access->isAllowed()) {
          continue;
        }
        $variables['footer_unl'][] = [
          'titulo' => $elemento->link->getTitle(),
          'url' => $elemento->link->getUrlObject()->toString(),
        ];
      }
      $variables['#cache']['tags'][] = 'config:system.menu.footer-unl';
    }

        // =========================================================
    // 2. HERO (micrositio, facultad o carrera)
    // =========================================================
    if ($node->hasField('field_imagen_hero') && !$node->get('field_imagen_hero')->isEmpty()) {
      $build = $node->get('field_imagen_hero')->view('default');
      $hero_diapositivas = [];

      foreach (\Drupal\Core\Render\Element::children($build) as $delta) {
        $hero_diapositivas[] = $build[$delta];
      }

      $variables['hero_diapositivas'] = $hero_diapositivas;
      $variables['hero_titulo_seguro'] = $node->getTitle();
      $variables['hero_tipo'] = 'micrositio';

      $generador_url = \Drupal::service('file_url_generator');

      // ---------- FACULTAD: franja de datos con íconos subidos (Dato Facultad) ----------
      if ($node->bundle() === 'facultades') {
        $variables['hero_tipo'] = 'facultad';
        $variables['hero_facultad'] = $node->hasField('field_codigo') ? $node->get('field_codigo')->value : $codigo;
        $variables['loader_logo'] = theme_get_setting('logo.url');
        $variables['hero_datos'] = [];

        if ($node->hasField('field_datos_facultad')) {
          foreach ($node->get('field_datos_facultad') as $item) {
            $dato = $item->entity;
            if (!$dato) continue;

            $archivo = $dato->hasField('field_icono') ? $dato->get('field_icono')->entity : null;
            $variables['hero_datos'][] = [
              'icono_url' => $archivo ? $generador_url->generateString($archivo->getFileUri()) : '',
              'valor' => $dato->hasField('field_valor') ? $dato->get('field_valor')->value : '',
              'etiqueta' => $dato->hasField('field_etiqueta') ? $dato->get('field_etiqueta')->value : '',
            ];
          }
        }
      }

      // ---------- CARRERA: nombre, descripción, botones y datos ----------
      // Todo sale de los campos de la carrera: se edita una vez y cambia en todos lados.
      elseif ($node->bundle() === 'carrera') {
        $variables['hero_tipo'] = 'carrera';
        // Mismo código de facultad que usa el hero de facultad → mismo color
        $variables['hero_facultad'] = $node->hasField('field_codigo') ? $node->get('field_codigo')->value : $codigo;

        $variables['hero_descripcion'] = _unl_theme_valor_legible($node, 'field_descripcion_corta');

        // Botón Admisiones
        $variables['hero_admisiones'] = '';
        if ($node->hasField('field_enlace_admisiones') && !$node->get('field_enlace_admisiones')->isEmpty()) {
          $variables['hero_admisiones'] = $node->get('field_enlace_admisiones')->first()->getUrl()->toString();
        }

        // Botón Brochure (PDF)
        $variables['hero_brochure'] = '';
        if ($node->hasField('field_brochure') && !$node->get('field_brochure')->isEmpty()) {
          $pdf = $node->get('field_brochure')->entity;
          if ($pdf) {
            $variables['hero_brochure'] = $generador_url->generateString($pdf->getFileUri());
          }
        }

        // Franja de datos: valores de los campos de la carrera.
        // El ícono lo pone el CSS según la clave (hero-micrositio__dato--titulo, etc.)
        $semestres = _unl_theme_valor_legible($node, 'field_semestres');
        $datos = [
          ['clave' => 'titulo',     'etiqueta' => 'Título a obtener',       'valor' => _unl_theme_valor_legible($node, 'field_titulo_obtener')],
          ['clave' => 'perfil',     'etiqueta' => 'Perfil profesional',     'valor' => _unl_theme_valor_legible($node, 'field_perfil_profesional')],
          ['clave' => 'duracion',   'etiqueta' => 'Duración',               'valor' => $semestres ? $semestres . ($semestres == 1 ? ' periodo académico' : ' periodos académicos') : ''],
          ['clave' => 'modalidad',  'etiqueta' => 'Modalidad',              'valor' => _unl_theme_valor_legible($node, 'field_modalidad')],
          ['clave' => 'titulacion', 'etiqueta' => 'Opciones de titulación', 'valor' => _unl_theme_valor_legible($node, 'field_opciones_titulacion')],
        ];

        $variables['hero_datos'] = [];
        foreach ($datos as $dato) {
          // Dato vacío: no se muestra (ni su línea separadora)
          if ($dato['valor'] === '' || $dato['valor'] === NULL) continue;
          $variables['hero_datos'][] = $dato;
        }
      }
    }
  }
}

/**
 * Variables específicas para los Nodos.
 */
function unl_theme_preprocess_node(&$variables) {
  $node = $variables['node'];

  // =========================================================
  // TARJETA DE CARRERA (franja de carreras de la facultad)
  // =========================================================
  if ($node->bundle() === 'carrera' && $variables['view_mode'] === 'tarjeta') {

    // Devuelve la etiqueta de una lista ("Presencial"), no la clave ("presencial")
    $etiqueta = function ($campo) use ($node) {
      if (!$node->hasField($campo) || $node->get($campo)->isEmpty()) {
        return '';
      }
      $definicion = $node->get($campo)->getFieldDefinition()->getFieldStorageDefinition();
      $valores = options_allowed_values($definicion, $node);
      return $valores[$node->get($campo)->value] ?? '';
    };

    // URL de la foto vertical
    $foto_url = '';
    $media = $node->get('field_foto_carrera')->entity;
    if ($media) {
      $archivo = \Drupal\file\Entity\File::load($media->getSource()->getSourceFieldValue($media));
      if ($archivo) {
        $foto_url = \Drupal::service('file_url_generator')->generateString($archivo->getFileUri());
      }
    }

    $variables['carrera'] = [
      'foto_url' => $foto_url,
      'tipo' => $etiqueta('field_tipo_carrera'),
      'modalidad' => $etiqueta('field_modalidad'),
      'semestres' => $node->get('field_semestres')->value,
      'puntaje' => $node->get('field_puntaje_minimo')->value,
      'cupos' => $node->get('field_cupos')->value,
      'url' => $node->toUrl()->toString(),
    ];
  }

  // =========================================================
  // EVENTOS: código de la facultad de su área (color de la línea)
  // Departamento → Facultad (nodo) → field_codigo.
  // Sin facultad queda vacío y la línea se queda roja.
  // =========================================================
  if ($node->bundle() === 'evento' && $node->hasField('field_area')) {
    $variables['evento_facultad'] = '';
    $termino = $node->get('field_area')->entity;
    if ($termino && $termino->hasField('field_facultad')) {
      $facultad = $termino->get('field_facultad')->entity;
      if ($facultad && $facultad->hasField('field_codigo')) {
        $variables['evento_facultad'] = $facultad->get('field_codigo')->value;
      }
      // Si se cambia la facultad del departamento, la tarjeta se actualiza
      $variables['#cache']['tags'][] = 'taxonomy_term:' . $termino->id();
    }
  }

  // =========================================================
  // PÁGINA /acceso-pcd: año del LOTAIP más reciente
  // =========================================================
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());

  if ($alias === '/acceso-pcd') {
    $variables['lotaip_anio_id'] = NULL;
    $variables['lotaip_anio'] = '';

    $ids = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('type', 'ley_transparencia')
      ->condition('status', 1)
      ->exists('field_anio.entity.name')
      ->sort('field_anio.entity.name', 'DESC')
      ->range(0, 1)
      ->execute();

    if ($ids) {
      $ultimo = \Drupal::entityTypeManager()->getStorage('node')->load(reset($ids));
      $termino = $ultimo->get('field_anio')->entity;
      if ($termino) {
        $variables['lotaip_anio_id'] = $termino->id();
        $variables['lotaip_anio'] = $termino->label();
      }
    }
    $variables['#cache']['tags'][] = 'node_list';
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function unl_theme_page_attachments_alter(array &$attachments) {
  $viewport = [
    '#type' => 'html_tag',
    '#tag' => 'meta',
    '#attributes' => [
      'name' => 'viewport',
      'content' => 'width=device-width, initial-scale=1',
    ],
  ];
  $attachments['#attached']['html_head'][] = [$viewport, 'viewport'];
}

/**
 * Implements hook_theme_suggestions_node_alter().
 */
function unl_theme_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
 
  if ($alias === '/acceso-pcd') {
    $suggestions[] = 'node__acceso_pcd';
  }
}

/**
 * Implements hook_theme_suggestions_menu_alter().
 */
function unl_theme_theme_suggestions_menu_alter(array &$suggestions, array $variables) {
  $menu = $variables['menu_name'] ?? '';
  if (preg_match('/^menu-(fjsa|fsh|feirnnr|farnr|feac)$/', $menu)) {
    $suggestions[] = 'menu__facultad';
  }
}

/**
 * Implements hook_preprocess_paragraph__TYPE() para Listado de carreras.
 *
 * Inserta la vista Carreras por facultad; la vista filtra sola
 * por el código de la facultad que está en la URL.
 */
function unl_theme_preprocess_paragraph__listado_carreras(&$variables) {
  $variables['carreras'] = views_embed_view('carreras_facultad', 'block_1');
}

/**
 * Implements hook_preprocess_paragraph__TYPE() para Banner botones.
 *
 * Prepara la URL de la imagen de fondo y la lista de botones.
 */
function unl_theme_preprocess_paragraph__banner_botones(&$variables) {
  $paragraph = $variables['paragraph'];

  // Imagen de fondo: funciona si field_imagen es Multimedia o Imagen
  $variables['fondo_url'] = '';
  if ($paragraph->hasField('field_imagen') && !$paragraph->get('field_imagen')->isEmpty()) {
    $entidad = $paragraph->get('field_imagen')->entity;
    $archivo = $entidad instanceof \Drupal\media\MediaInterface
      ? \Drupal\file\Entity\File::load($entidad->getSource()->getSourceFieldValue($entidad))
      : $entidad;
    if ($archivo instanceof \Drupal\file\FileInterface) {
      $variables['fondo_url'] = \Drupal::service('file_url_generator')->generateString($archivo->getFileUri());
    }
  }

  // Botones
  $variables['botones'] = [];
  if ($paragraph->hasField('field_enlaces')) {
    foreach ($paragraph->get('field_enlaces') as $enlace) {
      $variables['botones'][] = [
        'titulo' => $enlace->title,
        'url' => $enlace->getUrl()->toString(),
      ];
    }
  }
}

/**
 * Implements hook_preprocess_paragraph__TYPE() para Redes sociales.
 *
 * Reconoce la red por el dominio del enlace y le asigna su ícono y nombre.
 */
function unl_theme_preprocess_paragraph__redes_sociales(&$variables) {
  // dominio => [clave del ícono, nombre que leen los lectores de pantalla]
  $redes = [
    'facebook.com' => ['facebook', 'Facebook'],
    'fb.com' => ['facebook', 'Facebook'],
    'x.com' => ['x', 'X'],
    'twitter.com' => ['x', 'X'],
    'linkedin.com' => ['linkedin', 'LinkedIn'],
    'instagram.com' => ['instagram', 'Instagram'],
    'youtube.com' => ['youtube', 'YouTube'],
    'youtu.be' => ['youtube', 'YouTube'],
    'tiktok.com' => ['tiktok', 'TikTok'],
    'wa.me' => ['whatsapp', 'WhatsApp'],
  ];

    $variables['redes'] = [];
  foreach ($variables['paragraph']->get('field_redes') as $enlace) {
    $url = $enlace->getUrl()->toString();
    $host = strtolower(parse_url($url, PHP_URL_HOST) ?? '');

    // Busca la red por el final del dominio, así reconoce también
    // es-la.facebook.com, m.youtube.com, ec.linkedin.com, etc.
    $icono = 'enlace';
    $nombre = $host;
    foreach ($redes as $dominio => [$clave, $etiqueta]) {
      if ($host === $dominio || str_ends_with($host, '.' . $dominio)) {
        $icono = $clave;
        $nombre = $etiqueta;
        break;
      }
    }

    $variables['redes'][] = [
      'url' => $url,
      'icono' => $icono,
      'nombre' => $nombre,
    ];
  }
}

/**
 * Implements hook_preprocess_paragraph__TYPE() para Imagen galería.
 *
 * Prepara la URL de la foto y la URL del enlace (opcional).
 */
function unl_theme_preprocess_paragraph__imagen_galeria(&$variables) {
  $paragraph = $variables['paragraph'];

  // Foto: funciona si field_imagen es Multimedia o Imagen
  $variables['imagen_url'] = '';
  if ($paragraph->hasField('field_imagen') && !$paragraph->get('field_imagen')->isEmpty()) {
    $entidad = $paragraph->get('field_imagen')->entity;
    $archivo = $entidad instanceof \Drupal\media\MediaInterface
      ? \Drupal\file\Entity\File::load($entidad->getSource()->getSourceFieldValue($entidad))
      : $entidad;
    if ($archivo instanceof \Drupal\file\FileInterface) {
      $variables['imagen_url'] = \Drupal::service('file_url_generator')->generateString($archivo->getFileUri());
    }
  }

  // Enlace opcional
  $variables['enlace_url'] = '';
  if ($paragraph->hasField('field_enlace') && !$paragraph->get('field_enlace')->isEmpty()) {
    $variables['enlace_url'] = $paragraph->get('field_enlace')->first()->getUrl()->toString();
  }
}


function unl_theme_preprocess_paragraph__perfil(array &$variables) {
  /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['ocultar_perfil'] = FALSE;

  // Texto largo: usa la versión procesada si el campo tiene formato.
  $texto = function (FieldableEntityInterface $entidad, string $campo) {
    if (!$entidad->hasField($campo) || $entidad->get($campo)->isEmpty()) {
      return NULL;
    }
    $item = $entidad->get($campo)->first();
    return isset($item->getProperties()['processed']) ? $item->processed : $item->value;
  };

  // Campo renderizado con la configuración de "Gestionar presentación" del párrafo.
  $display = \Drupal::service('entity_display.repository')
    ->getViewDisplay('paragraph', 'perfil', $variables['view_mode'] ?? 'default');
  $render = function (FieldableEntityInterface $entidad, string $campo, string $campo_parrafo) use ($display) {
    if (!$entidad->hasField($campo) || $entidad->get($campo)->isEmpty()) {
      return NULL;
    }
    return $entidad->get($campo)->view($display->getComponent($campo_parrafo) ?: []);
  };

  $contacto = NULL;
  if ($paragraph->hasField('field_contacto') && !$paragraph->get('field_contacto')->isEmpty()) {
    $contacto = $paragraph->get('field_contacto')->entity;

    // Eliminado o despublicado: desaparece de todos lados.
    if (!$contacto || !$contacto->isPublished()) {
      $variables['ocultar_perfil'] = TRUE;
      return;
    }
  }

  if ($contacto) {
    // El contacto manda.
    $variables['perfil'] = [
      'nombre' => $contacto->label(),
      'cargo' => $contacto->get('field_cargo')->value,
      'imagen' => $render($contacto, 'field_foto_contacto', 'field_imagen'),
      'enlace' => $render($contacto, 'field_enlace_contacto', 'field_enlace'),
      'informacion_adicional' => $texto($contacto, 'field_informacion_adicional'),      
      'correos' => array_values(array_filter([
        $contacto->get('field_correo_departamental')->value,
        $contacto->get('field_correo_funcionario')->value,
      ])),    ];

    // Al editar o eliminar el contacto, se refrescan las páginas que lo usan.
    CacheableMetadata::createFromRenderArray($variables)
      ->addCacheableDependency($contacto)
      ->applyTo($variables);
  }
  else {
    // Perfil llenado a mano (como hasta ahora).
    $variables['perfil'] = [
      'nombre' => $paragraph->get('field_titulo')->value,
      'cargo' => $paragraph->get('field_descripcion')->value,
      'imagen' => $paragraph->get('field_imagen')->isEmpty() ? NULL : $variables['content']['field_imagen'],
      'enlace' => $paragraph->get('field_enlace')->isEmpty() ? NULL : $variables['content']['field_enlace'],
      'informacion_adicional' => $texto($paragraph, 'field_informacion_adicional'),
      'correos' => $paragraph->hasField('field_correo')
        ? array_values(array_filter([$paragraph->get('field_correo')->value]))
        : [],
    ];
  }
}

function unl_theme_preprocess_views_view(array &$variables) {
  if ($variables['view']->id() === 'directorio') {
    $variables['#attached']['library'][] = 'unl_theme/directorio';
  }
}

/**
 * Indica si un párrafo Perfil se debe mostrar.
 * Los perfiles manuales siempre se muestran; los que usan un contacto,
 * solo si el contacto existe y está publicado.
 */
function _unl_theme_perfil_visible($perfil, CacheableMetadata $cache): bool {
  if (!$perfil->hasField('field_contacto') || $perfil->get('field_contacto')->isEmpty()) {
    return TRUE;
  }
  $contacto = $perfil->get('field_contacto')->entity;
  if ($contacto) {
    // Si después lo vuelven a publicar, el grid se refresca solo.
    $cache->addCacheableDependency($contacto);
  }
  return $contacto && $contacto->isPublished();
}

function unl_theme_preprocess_paragraph__grid_perfiles(array &$variables) {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $visibles = [];

  // Botón del estilo banner
  $grid = $variables['paragraph'];
  $variables['boton'] = NULL;
  if ($grid->hasField('field_boton_admisiones') && !$grid->get('field_boton_admisiones')->isEmpty()) {
    $enlace = $grid->get('field_boton_admisiones')->first();
    $variables['boton'] = [
      'url' => $enlace->getUrl()->toString(),
      'texto' => $enlace->title ?: 'Admisiones',
    ];
  }

  if (isset($variables['content']['field_perfiles'])) {
    $campo = $variables['content']['field_perfiles'];

    foreach (Element::children($campo) as $delta) {
      $perfil = $campo[$delta]['#paragraph'] ?? NULL;

      if (!$perfil || _unl_theme_perfil_visible($perfil, $cache)) {
        $visibles[] = $campo[$delta];
      }
      // Se quitan todos; abajo se vuelven a poner solo los visibles.
      unset($campo[$delta]);
    }

    // Drupal recorre los elementos desde 0 y se detiene en el primer
    // número que falta: se renumeran seguidos (0, 1, 2...) sin huecos.
    foreach ($visibles as $nuevo_delta => $elemento) {
      $campo[$nuevo_delta] = $elemento;
    }

    $variables['content']['field_perfiles'] = $campo;
  }

  $variables['ocultar_grid'] = empty($visibles);
  $cache->applyTo($variables);
}